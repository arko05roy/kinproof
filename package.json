{
  "name": "kinproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "api",
    "web",
    "deployer"
  ],
  "scripts": {
    "compile": "npm run compact --workspace kinproof-contract",
    "test": "npm run test --workspace kinproof-contract",
    "typecheck": "npm run typecheck --workspace @kinproof/api && npm run typecheck --workspace kinproof-web",
    "build": "npm run build --workspace kinproof-contract && npm run build --workspace @kinproof/api && npm run build --workspace kinproof-web",
    "vercel-build": "cd web && npm run build",
    "dev": "npm run dev --workspace kinproof-web",
    "deploy:preprod": "npm run setup --workspace kinproof-deployer",
    "wallet:balance": "npm run check-balance --workspace kinproof-deployer -- --network preprod",
    "wallets:generate": "npm run wallets:generate --workspace kinproof-deployer -- --network preprod"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "fp-ts": "^2.16.11",
    "graphql": "^16.11.0",
    "effect": "^3.14.0",
    "pino": "^10.3.1",
    "rxjs": "^7.8.2",
    "semver": "^7.7.4"
  },
  "overrides": {
    "smoldot": "npm:@aspect-build/empty@0.0.0"
  }
}
